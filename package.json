{
  "name": "cumulative-labs-public-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "prepreview": "npm run assets",
    "preview": "vite preview",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "validate:build": "node scripts/validate-build.mjs"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.11"
  }
}
