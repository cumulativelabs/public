+/* Hero-only art direction. Copy, controls, and all following sections are unchanged. */
+.hero-section {
+  background: radial-gradient(ellipse at 75% 49%, #5a21402e, transparent 34%), radial-gradient(ellipse at 91% 26%, #39225820, transparent 35%), radial-gradient(ellipse at 54% 48%, #7a211716, transparent 38%), #030811;
+}
+.hero-section::before { opacity: 0.04; }
+.hero-knowledge {
+  position: absolute; left: 50%; top: 50%; z-index: 1; pointer-events: none;
+  width: var(--nexus-desktop-width); height: var(--nexus-desktop-height);
+  transform: translate(var(--nexus-desktop-x), var(--nexus-desktop-y));
+  overflow: hidden;
+}
+.hero-knowledge__plate { position: absolute; inset: 0; z-index: 0; display: block; pointer-events: none; }
+.hero-knowledge[data-art-ready='false'] .hero-knowledge__plate { visibility: hidden; }
+.hero-knowledge__plate img { width: 100%; height: 100%; display: block; object-fit: fill; opacity: .92; }
+.hero-knowledge__canvas { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; contain: strict; opacity: .66; }
+.hero-knowledge__fallback { z-index: 0; }
+.hero-knowledge__canvas, .hero-knowledge__fallback {
+  pointer-events: none;
+  mask-image: linear-gradient(90deg, #0005 0%, #0004 28%, #0009 46%, #000 62%);
+  -webkit-mask-image: linear-gradient(90deg, #0005 0%, #0004 28%, #0009 46%, #000 62%);
+}
+.hero-knowledge__fallback {
+  position: absolute; left: calc(-1 * var(--nexus-desktop-x)); top: calc(-1 * var(--nexus-desktop-y));
+  width: var(--nexus-fallback-desktop-width); height: auto; aspect-ratio: 1;
+  transform: translate(-50%, -50%); mask-image: none; -webkit-mask-image: none;
+}
+.hero-knowledge[data-ready='true'] .hero-knowledge__fallback { display: none; }
+.hero-section__mark { pointer-events: none; z-index: 1; }
+.hero-section__copy { position: relative; z-index: 2; }
+.hero-section__mark::before {
+  inset: 9%; filter: none;
+  background: radial-gradient(ellipse, #efa66609, #da578e09 40%, transparent 72%);
+}
+.hero-section__mark .brand-symbol { width: 31%; filter: drop-shadow(0 0 18px #ff4b971f) drop-shadow(0 0 38px #9448e61a); }
+.hero-section__inner { z-index: 3; }
+/* Keep the keyboard indicator distinct where artwork or the header crosses it. */
+.hero-section__actions a:focus-visible, .skip-link:focus-visible {
+  outline: 2px solid #ff9bca; outline-offset: 3px;
+  box-shadow: 0 0 0 7px #030811;
+}
+/* Bound luminous artwork beneath copy; keep the core and output unobscured. */
+@media (min-width: 781px) {
+  .hero-section__copy::before {
+    content: ''; position: absolute; z-index: -1; pointer-events: none;
+    inset: -1rem -3rem -1rem -1rem;
+    background: linear-gradient(90deg, #030811d9 calc(100% - 3rem), transparent);
+    mask-image: linear-gradient(transparent, #000 1rem, #000 calc(100% - 1rem), transparent);
+    -webkit-mask-image: linear-gradient(transparent, #000 1rem, #000 calc(100% - 1rem), transparent);
+  }
+}
+@media (max-width: 1000px) and (min-width: 781px) {
+  .hero-section__mark .brand-symbol { width: 34%; }
+}
+@media (max-width: 780px) {
+  .hero-section { padding-bottom: 1.4rem; background: radial-gradient(ellipse at 96% 60%, #5232501c, transparent 65%), radial-gradient(ellipse at 70% 94%, #59296625, transparent 47%), #030811; }
+  .hero-section__mark { width: 8.15rem; margin: -0.35rem 11% 0 auto; }
+  .hero-section__mark .brand-symbol { width: 49%; }
+  .hero-knowledge__canvas, .hero-knowledge__fallback {
+    mask-image: linear-gradient(to bottom, #00000026 8%, #00000040 30%, #0000008f 49%, #000 68%);
+    -webkit-mask-image: linear-gradient(to bottom, #00000026 8%, #00000040 30%, #0000008f 49%, #000 68%);
+  }
+  .hero-knowledge {
+    width: var(--nexus-mobile-width); height: var(--nexus-mobile-height);
+    transform: translate(var(--nexus-mobile-x), var(--nexus-mobile-y));
+  }
+  .hero-knowledge__fallback {
+    left: calc(-1 * var(--nexus-mobile-x)); top: calc(-1 * var(--nexus-mobile-y));
+    width: var(--nexus-fallback-mobile-width); mask-image: none; -webkit-mask-image: none;
+  }
+  .hero-knowledge__plate img { object-fit: fill; opacity: 1; }
+  .hero-knowledge__canvas { opacity: .48; }
+  .hero-section__actions .button { position: relative; z-index: 1; }
+}
+/* The capped phone plate exposes its edges on tablets. Fade the shared plane,
+   including the live/fallback layer, without moving its core or either port. */
+@media (min-width: 431px) and (max-width: 780px) {
+  .hero-knowledge {
+    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 96%, transparent);
+    -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 96%, transparent);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hero-knowledge *, .hero-section__mark { animation: none !important; transition: none !important; }
+}
